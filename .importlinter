# Import rules between contexts and layers (docs/architecture.md, ADR-003).
# Run: uv run lint-imports. An exception goes in `ignore_imports` with a comment
# explaining why; more than a couple of the same kind means the rule needs revisiting.

[importlinter]
root_packages =
    app

# Inside a context, a layer may import the layers below it, never the ones above.
# Parentheses mark layers a context may not have (auth has no event handlers).
[importlinter:contract:layers]
name = Layers inside each context
type = layers
containers =
    app.auth
    app.workshops
layers =
    api | (event_handlers) | (jobs)
    use_cases
    (services)
    repos
    models | schemas | (exceptions)
exhaustive = true

# Infrastructure does not know the domain: contexts plug into it (handlers register
# themselves, routers are composed in app.api), never the other way round.
[importlinter:contract:core]
name = Core does not import contexts, deps, api or the registry
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.auth
    app.workshops
    app.deps
    app.api
    app.db_registry

# Contexts are independent. Workshops reaches the current user through app.deps (the
# shared dependency), never by importing auth directly; workshops and users are linked
# by organizer_id and attendee_id only, without an ORM relationship.
# allow_indirect_imports: app.deps.auth imports the user model, and that chain is the
# intended one. A context that uses app.deps needs it in its contract against app.auth.
[importlinter:contract:workshops-auth]
name = Workshops does not import auth directly
type = forbidden
allow_indirect_imports = true
source_modules =
    app.workshops
forbidden_modules =
    app.auth

[importlinter:contract:auth-workshops]
name = Auth does not import workshops
type = forbidden
source_modules =
    app.auth
forbidden_modules =
    app.workshops
