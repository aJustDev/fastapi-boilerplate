# Copy to .env.local (or .env.<ENVIRONMENT>) and adjust. Every Settings field is listed
# here; tests/unit/core/test_env_example_sync.py fails when they drift apart.

# Required: the app does not start without it. "local" is the only value that accepts the
# placeholder SECRET_KEY and the wildcard hosts below; the Docker image defaults to production.
ENVIRONMENT=local

# App
APP_NAME=FastAPI App
# Read from the installed package (pyproject.toml); set it only to override.
# APP_VERSION=
APP_DESCRIPTION=

# Database: individual variables, or a full DATABASE_URL that takes precedence
DB_HOST=localhost
DB_PORT=5434
DB_NAME=app_db
DB_USER=postgres
DB_PASSWORD=postgres
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/db

# Database pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Connection and query limits: client side (seconds) and server side (milliseconds)
DB_CONNECT_TIMEOUT=10
DB_COMMAND_TIMEOUT=30
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000

# Auth
# Placeholder, accepted only with ENVIRONMENT=local. Anywhere else, at least 32 random bytes:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-use-a-32-byte-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS. Outside local it has to be set: the exact frontend origins, or [] if no browser
# calls the API
ALLOWED_ORIGINS=["http://localhost:3000"]

# Network exposure. Outside local: explicit hosts, and FORWARDED_ALLOW_IPS set to the address
# or subnet of the reverse proxy (empty when clients connect directly), never "*"
ALLOWED_HOSTS=["*"]
FORWARDED_ALLOW_IPS=127.0.0.1

# Security headers; HSTS only behind HTTPS
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_STRICT=5/minute

# Metrics; with a token, /v1/metrics requires "Authorization: Bearer <token>"
METRICS_ENABLED=true
METRICS_TOKEN=

# Swagger UI (/docs), ReDoc and /openapi.json: off by default, on for local work
DOCS_ENABLED=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=auto

# Webhook used by the example item event handlers
WEBHOOK_URL=

# Background workers inside the API process; false to run them with `python -m app.cli worker`
OUTBOX_WORKER_ENABLED=true
JOB_WORKER_ENABLED=true

# Event bus
OUTBOX_POLL_INTERVAL_SECONDS=30
OUTBOX_MAX_RETRIES=12
OUTBOX_HANDLER_TIMEOUT_SECONDS=30
OUTBOX_CLEANUP_DAYS=30
OUTBOX_CLEANUP_BATCH_SIZE=1000

# Jobs
JOB_POLL_INTERVAL_SECONDS=15
JOB_HANDLER_TIMEOUT_SECONDS=60
# Must be at least 2 * JOB_HANDLER_TIMEOUT_SECONDS
JOB_LEASE_SECONDS=120
